# Clé secrète Stripe (tableau de bord Stripe > Développeurs > Clés API)
STRIPE_SECRET_KEY=sk_test_...

# Secret du webhook Stripe (créé après avoir ajouté l'endpoint dans Stripe,
# voir README section "Automatisation CJ Dropshipping")
STRIPE_WEBHOOK_SECRET=whsec_...

# URL publique de ton site (utilisée pour les redirections Stripe)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clé API CJ Dropshipping (CJ > Source > API > Add API)
CJ_API_KEY=CJUserNum@api@...

# true = les commandes CJ sont payées automatiquement avec ton solde CJ dès
# qu'un client paie sur ton site. false (ou absent) = les commandes sont
# créées chez CJ mais restent "non payées", à valider toi-même dans MyCJ.
# Laisse à false tant que tu n'as pas testé le flux de bout en bout.
CJ_AUTO_PAY=false

# Secret perso pour protéger la route /api/admin/find-vid (invente une chaîne
# aléatoire, ex: openssl rand -hex 16)
ADMIN_SECRET=change-moi
