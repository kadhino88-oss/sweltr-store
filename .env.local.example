# Clé secrète Stripe (tableau de bord Stripe > Développeurs > Clés API)
STRIPE_SECRET_KEY=sk_test_...

# Secret du webhook Stripe (créé après avoir ajouté l'endpoint dans Stripe,
# voir README section "Automatisation CJ Dropshipping")
STRIPE_WEBHOOK_SECRET=whsec_...

# URL du site, utilisée côté serveur pour les métadonnées et les redirections Stripe
SITE_URL=http://localhost:3000

# Clé API CJ Dropshipping (CJ > Source > API > Add API)
CJ_API_KEY=CJUserNum@api@...

# true = tentative de paiement automatique des commandes CJ avec ton solde.
# Cette option exige aussi CJ_PAYMENT_FLOW_VALIDATED=true, à définir seulement
# après un test réel et vérifié du flux complet ; sinon laisse à false.
CJ_AUTO_PAY=false

# Laisse à false jusqu'à ce que la commande CJ testée ait été créée, confirmée,
# payée et retrouvée sans double débit dans MyCJ.
CJ_PAYMENT_FLOW_VALIDATED=false

# Secret perso pour protéger la route /api/admin/find-vid (invente une chaîne
# aléatoire, ex: openssl rand -hex 16)
ADMIN_SECRET=change-moi

# Laisse à false tant que la variante exacte, le stock, l'expédition et le coût livré
# de l'ensemble thermique n'ont pas été confirmés pour la Suisse et la France.
THERMAL_PRODUCT_SALES_ENABLED=false

# Laisse à false jusqu'à validation de chaque référence exacte, de son stock,
# d'un transport suivi livrant en 10 jours maximum pour chaque pays proposé,
# du prix de transport facturé au client, des marges et d'une commande test.
# Le checkout reste bloqué en mode test comme en mode live tant que ce drapeau
# n'est pas activé.
STORE_SALES_ENABLED=false
